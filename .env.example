VITE_API_BASE_URL=http://127.0.0.1:8000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-secret-at-least-32-characters
BETTER_AUTH_API_KEY=your_better_auth_infrastructure_key
# Supabase session pooler. The same value must be set on Vercel.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
VITE_POSTHOG_KEY=your_posthog_project_token
VITE_POSTHOG_HOST=https://your-posthog-host
